CREATE TABLE tbmk_PhuLucHopDong
(
    PhuLucID BIGINT IDENTITY(1,1) NOT NULL,
    
    SoPhuLuc VARCHAR(50) NOT NULL,
    Sohopdong VARCHAR(50) NOT NULL,

    LanDieuChinh INT NOT NULL DEFAULT 1,

    NgayLap DATETIME NOT NULL DEFAULT GETDATE(),
    NgayHieuLuc DATETIME NULL,

    LyDoDieuChinh NVARCHAR(1000) NULL,

    GiaTriTruocDieuChinh DECIMAL(18,2) NULL,
    GiaTriSauDieuChinh DECIMAL(18,2) NULL,

    GiaTriTangGiam AS
    (
        ISNULL(GiaTriSauDieuChinh,0)
        - ISNULL(GiaTriTruocDieuChinh,0)
    ),

    TrangThai TINYINT NOT NULL DEFAULT 0,
    /*
        0 = Nháp
        1 = Chờ duyệt
        2 = Đã duyệt
        3 = Hủy
    */

    GhiChu NVARCHAR(MAX) NULL,

    CreatedBy VARCHAR(50) NULL,
    CreatedDate DATETIME NOT NULL DEFAULT GETDATE(),

    ApprovedBy VARCHAR(50) NULL,
    ApprovedDate DATETIME NULL,

    CONSTRAINT PK_tbmk_PhuLucHopDong
        PRIMARY KEY (PhuLucID),

    CONSTRAINT UQ_tbmk_PhuLucHopDong_SoPhuLuc
        UNIQUE (SoPhuLuc)
);
GO