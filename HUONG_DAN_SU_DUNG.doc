f;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Tên khách hàng (Tên Cô dâu &amp; Chú rể).</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Số điện thoại Cô dâu, số điện thoại Chú rể.</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Tên người đại diện liên hệ &amp; Số điện thoại người đại diện.</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Địa chỉ gia đình, khu vực ở, Email (nếu có).</span></p></li></ul><ol style="padding-left:35pt"><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Bấm </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Lưu</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">. Hồ sơ này sẽ được dùng xuyên suốt cho các bước Tham Quan, Cọc Chỗ, Ký Hợp Đồng và Quyết Toán.</span></p></li></ol><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:12pt;background-color:#ffffff;color:#2563eb;mso-style-textfill-fill-color:#2563eb"><b>Bước 2: Đón Tiếp Khách Tham Quan</b></span></p><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'Times New Roman';font-size:10pt;color:#000000;mso-style-textfill-fill-color:#000000"><img style="max-width:100%;" width="602" height="272" src="data:image/png;base64,"/></span></p><ul style="padding-left:36pt"><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Mục đích</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Ghi nhận nhu cầu và nội dung tư vấn khi khách ghé nhà hàng xem sảnh.</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Thao tác</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">:</span></p></li></ul><ol style="padding-left:35pt"><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Vào menu </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Quản lý tiệc</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> ➔ Chọn </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Khách tham quan</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Bấm nút </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Thêm</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">, chọn tên Khách hàng đã tạo ở Bước 1 (thông tin tên, SĐT sẽ tự động hiển thị).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Nhập ngày dự kiến tổ chức tiệc, số lượng bàn dự kiến, sảnh tiệc quan tâm, các ý kiến thỏa thuận và đề xuất của khách.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Bấm </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Lưu</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">. Thông tin này sẽ tự động liên kết khi khách quay lại đặt cọc.</span></p></li></ol><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:12pt;background-color:#ffffff;color:#2563eb;mso-style-textfill-fill-color:#2563eb"><b>Bước 3: Biên Nhận Cọc Chỗ (Lần 1 &amp; Lần 2)</b></span></p><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'Times New Roman';font-size:10pt;color:#000000;mso-style-textfill-fill-color:#000000"><img style="max-width:100%;" width="602" height="303" src="data:image/png;base64,"/></span></p><ul style="padding-left:36pt"><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Mục đích</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Giữ sảnh và ngày tổ chức tiệc cho khách hàng.</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Thao tác Cọc Lần 1</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">:</span></p></li></ul><ol style="padding-left:35pt"><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Vào </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Quản lý tiệc</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> ➔ </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Biên nhận cọc chỗ lần 1</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Chọn tên khách hàng từ danh sách (thông tin từ bước Tham Quan sẽ tự động điền vào).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Chọn </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Ngày tổ chức</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> (dương lịch), hệ thống sẽ </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>tự động tính ra ngày âm lịch</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> tương ứng (VD: </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"><i>Nhằm thứ Bảy, ngày 11 tháng 12 năm Quý Tỵ</i></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Chọn </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Sảnh tiệc</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> (đánh dấu chọn sảnh chính nếu chọn nhiều sảnh) và nhập số tiền cọc.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Bấm </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Lưu</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> và bấm </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>In</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> để in Biên nhận đặt cọc cho khách.</span></p></li></ol><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none">&nbsp;</p><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:12pt;background-color:#ffffff;color:#2563eb;mso-style-textfill-fill-color:#2563eb"><b>Bước 4: Lập Hợp Đồng Tiệc Cưới</b></span></p><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'Times New Roman';font-size:10pt;color:#000000;mso-style-textfill-fill-color:#000000"><img style="max-width:100%;" width="602" height="255" src="data:image/png;base64,"/></span></p><ul style="padding-left:36pt"><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Mục đích</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Ký kết hợp đồng chính thức, chốt thực đơn, đồ uống và các dịch vụ cưới.</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Thao tác</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">:</span></p></li></ul><ol style="padding-left:35pt"><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Vào </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Quản lý tiệc</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> ➔ </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Hợp đồng</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Chọn thông tin biên nhận cọc (hệ thống tự lấy ngày tổ chức, sảnh tiệc và số tiền đã cọc sang).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Tab Bàn tiệc</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Nhập số lượng bàn mặn/chay, tiền bàn, chọn </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Gói cưới / Ưu đãi Combo</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">, nhập tỷ lệ giảm giá % (nếu có).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Tab Thực đơn mặn &amp; Thực đơn chay</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Chọn các món ăn theo thứ tự phục vụ (STT món), đánh dấu món khai vị đầu giờ.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Tab Thức uống</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Chọn loại bia, nước ngọt, nước suối (đánh dấu khuyến mãi hoặc tính tiền theo bàn/chai).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Tab Dịch vụ</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Chọn các dịch vụ cưới đi kèm (MC, âm thanh, ánh sáng, tháp bánh, tháp champagne, trang trí sảnh...).</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Tab Ưu đãi</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Xem các quà tặng ưu đãi theo gói hoặc nhập yêu cầu bù tiền nếu khách đổi quà.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Tab Setup print</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Đẩy khoảng cách các dòng điều khoản để căn chỉnh trang in đẹp mắt.</span></p></li><li style="list-style-type: decimal"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">Bấm </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Lưu</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> và chọn </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>In Hợp đồng</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">.</span></p></li></ol><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none">&nbsp;</p><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:12pt;background-color:#ffffff;color:#2563eb;mso-style-textfill-fill-color:#2563eb"><b>Bước 5: Thay Đổi - Bổ Sung Hợp Đồng</b></span></p><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'Times New Roman';font-size:10pt;color:#000000;mso-style-textfill-fill-color:#000000"><img style="max-width:100%;" width="602" height="287" src="data:image/png;base64,"/></span></p><ul style="padding-left:36pt"><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;mso-border-left-alt:0.25pt solid #ffffff;mso-border-top-alt:0.25pt solid #ffffff;mso-border-right-alt:0.25pt solid #ffffff;mso-border-bottom-alt:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Mục đích</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Xử lý khi khách hàng yêu cầu thay đổi số bàn, đổi món ăn, thêm dịch vụ sau khi đã ký Hợp đồng.</span></p></li><li style="list-style-type: disc"><p style="line-height:0.1pt;margin-top:3.0000000000000004pt;margin-bottom:3.0000000000000004pt;background-color:#ffffff;border:none;border-left:0.25pt solid #ffffff;border-top:0.25pt solid #ffffff;border-right:0.25pt solid #ffffff;border-bottom:0.25pt solid #ffffff;mso-border-between:none"><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Thao tác</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">: Vào </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Quản lý tiệc</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> ➔ </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Thông tin thay đổi - bổ sung</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b"> ➔ Chọn mã Hợp đồng cần sửa ➔ Chỉ cần nhập các nội dung mới/thay đổi ➔ Bấm </span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#0f172a;mso-style-textfill-fill-color:#0f172a"><b>Lưu</b></span><span style="font-family:'segoe ui';font-size:11pt;background-color:#ffffff;color:#1e293b;mso-style-textfill-fill-color:#1e293b">.</span></p></li></ul><p style="line-height:0.1pt;margin-top:14pt;margin-bottom:6.000000000000001pt;backgrou