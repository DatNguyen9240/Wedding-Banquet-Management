<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Chuyển tiếp các request /docserver/ sang Node.js Document Server (127.0.0.1:8081) -->
        <rule name="DocServer Proxy" stopProcessing="true">
          <match url="^docserver/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8081/{R:1}" />
        </rule>
        
        <!-- Rule 1: Chuyển tiếp các request API OnlyOffice bắt đầu bằng /onlyoffice/ (bỏ prefix /onlyoffice/) -->
        <rule name="OnlyOffice Prefix Proxy" stopProcessing="true">
          <match url="^onlyoffice/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>

        <!-- Rule 2: Chuyển tiếp các request assets của OnlyOffice (bao gồm thư mục phiên bản dạng /9.4.0-.../ hoặc truy cập trực tiếp từ root) -->
        <rule name="OnlyOffice Assets Proxy" stopProcessing="true">
          <match url="^(?:[\w\.-]+/)?(?:web-apps|sdkjs|fonts|welcome|dictionaries|info|coauthoring)(?:/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
