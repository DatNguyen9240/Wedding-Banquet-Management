<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Chuyển tiếp các request /docserver/ sang Node.js Document Server (127.0.0.1:8081) -->
        <rule name="DocServer Proxy" stopProcessing="true">
          <match url="^docserver/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8081/{R:1}" />
        </rule>
        
        <!-- Chuyển tiếp và chuẩn hóa các request ONLYOFFICE (tự động loại bỏ prefix /onlyoffice/ và version cache của trình duyệt để tránh lỗi 404) -->
        <rule name="OnlyOffice Unified Proxy" stopProcessing="true">
          <match url="^(?:onlyoffice/)?(?:[\d\.]+-[\da-fA-F]+/)?(web-apps|sdkjs|fonts|welcome|dictionaries|info|coauthoring)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}{R:2}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
